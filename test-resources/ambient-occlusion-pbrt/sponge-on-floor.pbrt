# Ambient-occlusion twin (pbrt-v4) of the optix-jni#106 sponge scene (AmbientOcclusionPbrtSuite).
#
# A level-1 Menger sponge (20 cubes of edge 1/3, centres (i,j,k)/3 for i,j,k in -1..1 with
# |i|+|j|+|k| > 1) on a floor at y = -0.5. The `ambientocclusion` integrator returns the
# cosine-weighted share of hemisphere rays that escape, 1 for a fully open surface: exactly what
# optix-jni weights its ambient fill with. maxdistance is unlimited, as optix-jni's default radius.
#
# Camera: eye (-1.6, 1.4, 2.2) looking at (0, -0.1, 0), horizontal fov 60. pbrt applies fov to the
# shorter image axis (vertical at 4:3): 2*atan(tan(30 deg) * 600/800) = 46.83 deg. `Scale -1 1 1`
# turns pbrt's left-handed screen into optix-jni's right-handed one. A box pixel filter of radius
# 0.5 is a pixel's area average, the nearest pbrt has to optix-jni's single ray per pixel.
#
# Render with render-pbrt-reference.sh (never by hooks); the committed reference is its output.
# pbrt-v4 note: no WorldEnd directive (the world block ends at EOF).

Film "rgb"
    "string filename" "sponge-on-floor.exr"
    "integer xresolution" 400
    "integer yresolution" 300

Scale -1 1 1
LookAt -1.6 1.4 2.2
       0 -0.1 0
       0 1 0

Camera "perspective"
    "float fov" 46.83

Sampler "independent"
    "integer pixelsamples" 4096

PixelFilter "box"
    "float xradius" 0.5
    "float yradius" 0.5

Integrator "ambientocclusion"
    "bool cossample" true
    "float maxdistance" 1e30

WorldBegin

# Floor at y = -0.5 (optix-jni's plane is infinite; 1000 is far enough for any ray in the scene)
AttributeBegin
    Shape "trianglemesh"
        "integer indices" [ 0 1 2 0 2 3 ]
        "point3 P" [ -1000 -0.5 -1000  1000 -0.5 -1000  1000 -0.5 1000  -1000 -0.5 1000 ]
AttributeEnd

Shape "trianglemesh"
    "integer indices" [ 0 1 2 0 2 3 4 6 5 4 7 6 0 4 5 0 5 1 3 2 6 3 6 7 0 3 7 0 7 4 1 5 6 1 6 2 ]
    "point3 P" [ -0.5000000 -0.5000000 -0.5000000  -0.1666667 -0.5000000 -0.5000000  -0.1666667 -0.5000000 -0.1666667  -0.5000000 -0.5000000 -0.1666667  -0.5000000 -0.1666667 -0.5000000  -0.1666667 -0.1666667 -0.5000000  -0.1666667 -0.1666667 -0.1666667  -0.5000000 -0.1666667 -0.1666667 ]

Shape "trianglemesh"
    "integer indices" [ 0 1 2 0 2 3 4 6 5 4 7 6 0 4 5 0 5 1 3 2 6 3 6 7 0 3 7 0 7 4 1 5 6 1 6 2 ]
    "point3 P" [ -0.5000000 -0.5000000 -0.1666667  -0.1666667 -0.5000000 -0.1666667  -0.1666667 -0.5000000 0.1666667  -0.5000000 -0.5000000 0.1666667  -0.5000000 -0.1666667 -0.1666667  -0.1666667 -0.1666667 -0.1666667  -0.1666667 -0.1666667 0.1666667  -0.5000000 -0.1666667 0.1666667 ]

Shape "trianglemesh"
    "integer indices" [ 0 1 2 0 2 3 4 6 5 4 7 6 0 4 5 0 5 1 3 2 6 3 6 7 0 3 7 0 7 4 1 5 6 1 6 2 ]
    "point3 P" [ -0.5000000 -0.5000000 0.1666667  -0.1666667 -0.5000000 0.1666667  -0.1666667 -0.5000000 0.5000000  -0.5000000 -0.5000000 0.5000000  -0.5000000 -0.1666667 0.1666667  -0.1666667 -0.1666667 0.1666667  -0.1666667 -0.1666667 0.5000000  -0.5000000 -0.1666667 0.5000000 ]

