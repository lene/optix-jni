    "point3 P" [ -0.5000000 -0.1666667 -0.5000000  -0.1666667 -0.1666667 -0.5000000  -0.1666667 -0.1666667 -0.1666667  -0.5000000 -0.1666667 -0.1666667  -0.5000000 0.1666667 -0.5000000  -0.1666667 0.1666667 -0.5000000  -0.1666667 0.1666667 -0.1666667  -0.5000000 0.1666667 -0.1666667 ]

