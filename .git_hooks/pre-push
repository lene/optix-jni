#!/bin/sh
# Pre-push hook (Sprint 36 B3): thin wrapper. Change detection is unchanged
# (standards/hooks/lib.sh); this hook's only job is to compute HAS_*/QA_RANGES and hand
# the repo's fixed suite list to standards/scripts/qa-runner.sh, which runs each suite
# script (scripts/suites/*.sh) and decides its own PASS/FAIL/SKIP — replacing the old
# "No code changes — skipping pre-push checks" single-line skip with an honest per-suite
# summary (every suite always runs and self-reports).
#
# Detect changed files. The inline loop this replaces read only git's pre-push
# protocol from stdin, so running the hook by hand — no stdin — produced an empty file
# set, skipped every check below and exited 0 regardless of the diff. See
# standards/hooks/lib.sh for the three invocation contexts and why a TTY test alone
# does not cover them.
git fetch origin --quiet 2>/dev/null || true
if [ -r ./standards/hooks/lib.sh ]; then
  . ./standards/hooks/lib.sh
  RANGES=$(push_ranges); _rc=$?
  [ "$_rc" -eq 2 ] && exit 0   # push only deletes a branch
  # unquoted on purpose: split the newline-separated ranges into arguments
  CHANGED_FILES=$(changed_files $RANGES)
  assert_detection "$CHANGED_FILES" || exit 1
else
  # Branch predating standards enrollment: degrade to the same branch-vs-main
  # comparison rather than silently skipping.
  BASE=$(git merge-base origin/main HEAD 2>/dev/null)
  CHANGED_FILES=$(git diff --name-only "${BASE:-HEAD}" HEAD)
  RANGES="${BASE:-HEAD}..HEAD"
fi

export HAS_SCALA=$(echo "$CHANGED_FILES" | grep -cE '\.(scala|sbt)$|^project/')
export HAS_NATIVE=$(echo "$CHANGED_FILES" | grep -cE 'src/main/native/.*\.(cpp|cu|cuh|h)$|CMakeLists\.txt')
export QA_RANGES="$RANGES"

./standards/scripts/qa-runner.sh parity policy preflight lint unit native-logging native-checks
